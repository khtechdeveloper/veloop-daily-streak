{
  "info": {
    "name": "VELoop Daily Streak",
    "description": "Auth + Daily Streak endpoints, including negative/anti-cheat test requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Daily Streak - Normal Flow",
      "item": [
        {
          "name": "Get Streak",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/daily-streak"
          }
        },
        {
          "name": "Get Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/daily-streak/status"
          }
        },
        {
          "name": "Claim Day 1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/daily-streak/claim",
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Get Updated Streak",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/daily-streak"
          }
        },
        {
          "name": "Get History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/daily-streak/history"
          }
        },
        {
          "name": "Get Wallet",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/daily-streak/wallet"
          }
        }
      ]
    },
    {
      "name": "Negative / Anti-Cheat Tests",
      "item": [
        {
          "name": "Duplicate Claim (expect 409 ALREADY_CLAIMED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/daily-streak/claim",
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Fake Day + Reward (expect real eligible day claimed, not spoofed values)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/daily-streak/claim",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": 7,\n  \"reward\": 1000000,\n  \"currency\": \"VES\",\n  \"streak\": 99,\n  \"userId\": \"000000000000000000000000\"\n}"
            }
          }
        },
        {
          "name": "Claim With No Token (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/daily-streak/claim",
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Claim With Garbage Token (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer not-a-real-token" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/daily-streak/claim",
            "body": { "mode": "raw", "raw": "{}" }
          }
        }
      ]
    }
  ]
}
